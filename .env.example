# ============================================================
# QuickWash — environment variables
# Copy to .env.local and fill in the Paymob TEST values.
# ============================================================

# Public base URL of THIS app. Used to build Paymob callback/return URLs.
# Local dev: http://localhost:3000   |   Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Paymob (TEST) — SERVER-ONLY SECRETS. Never prefix these with NEXT_PUBLIC. -----
# Where to find each: see PAYMOB_SETUP.md
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# ----- Public, non-secret UI values (safe to expose) -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_STORE_URL=#
NEXT_PUBLIC_GOOGLE_PLAY_URL=#
NEXT_PUBLIC_CONTACT_PHONE=+201000000000
NEXT_PUBLIC_CONTACT_WHATSAPP=+201000000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
